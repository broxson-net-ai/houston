# Database
DATABASE_URL=postgres://houston:houston@localhost:5432/houston

# Application
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-secure-random-string

# Internal base URL for local-only automation (autonomous runner, canaries, etc.)
HOUSTON_INTERNAL_BASE_URL=http://127.0.0.1:3000
HOUSTON_CONTROL_PLANE_V1=false
HOUSTON_EXPORTS_ROOT=/Users/openclaw/openclaw-exports/projects
HOUSTON_ENABLE_RETIRED_TASK_SYSTEM=false

# Static API key for internal service-to-service calls (e.g. OpenClaw agents calling Houston)
# Generate with: openssl rand -hex 32
# Leave unset to disable API key auth (web UI session auth still works)
HOUSTON_API_KEY=

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=ws://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=

# OpenClaw Skills
OPENCLAW_SKILLS_PATH=/home/openclaw/.openclaw/workspace/skills

# Scheduler
DEFAULT_TIMEZONE=America/Los_Angeles
HOUSTON_DISPATCH_CONCURRENCY=5
HOUSTON_GRACE_WINDOW_SECONDS=300
HOUSTON_LOOKBACK_WINDOW_HOURS=48
HOUSTON_SCHEDULER_TICK_SECONDS=30
APPROVAL_RESUME_INTERVAL_MS=10000

# Gateway timeout/retry controls
HOUSTON_GATEWAY_REQUEST_TIMEOUT_MS=30000
HOUSTON_GATEWAY_CONNECT_TIMEOUT_MS=30000
HOUSTON_GATEWAY_RETRY_MAX_ATTEMPTS=3
HOUSTON_GATEWAY_RETRY_BASE_DELAY_MS=500
HOUSTON_GATEWAY_RETRY_MAX_DELAY_MS=8000

# Approval trust ladder
# Modes: always | once-per-session | once-ever | auto
HOUSTON_APPROVAL_TRUST_DEFAULT=always
# Selector keys support: role.trigger, role.*, *.trigger, default
# Staged rollout baseline: first external send per session needs review, repeats auto-satisfy
HOUSTON_APPROVAL_TRUST_MODES={"exec-assistant.external-send":"once-per-session","biz-ops-agent.external-send":"once-per-session"}
# Background trust verification window + cadence
HOUSTON_TRUST_VERIFY_WINDOW_HOURS=48
HOUSTON_TRUST_VERIFY_INTERVAL_MS=3600000
# Optional ops alert webhook for trust verification warnings/failures
HOUSTON_OPS_ALERT_WEBHOOK_URL=
HOUSTON_OPS_ALERT_MIN_INTERVAL_MS=900000

# Logs
MAX_LOG_BYTES=10485760
HOUSTON_LOG_RETENTION_DAYS=30
