generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  QUEUE
  BLOCKED
  IN_PROGRESS
  DONE
  FAILED
}

enum TaskRunStatus {
  ACCEPTED
  RUNNING
  COMPLETED
  FAILED
}

enum TaskEventType {
  CREATED
  SCHEDULED
  QUEUED
  DISPATCHED
  STARTED
  COMPLETED
  FAILED
  MISSED
  STATUS_CHANGED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

model Agent {
  id         String    @id @default(cuid())
  name       String
  avatarUrl  String?
  routingKey String    @unique
  enabled    Boolean   @default(true)
  tags       Json      @default("[]")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  templates  Template[]
  tasks      Task[]

  @@map("agents")
}

model PreInstructionsVersion {
  id        String   @id @default(cuid())
  version   Int
  content   String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("pre_instructions_versions")
}

model Template {
  id             String     @id @default(cuid())
  name           String
  defaultAgentId String?
  defaultAgent   Agent?     @relation(fields: [defaultAgentId], references: [id])
  skillRef       String?
  instructions   String
  tags           Json       @default("[]")
  priority       Int        @default(0)
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  schedules      Schedule[]
  tasks          Task[]

  @@map("templates")
}

model Schedule {
  id            String    @id @default(cuid())
  templateId    String
  template      Template  @relation(fields: [templateId], references: [id])
  cron          String
  timezone      String    @default("America/Los_Angeles")
  enabled       Boolean   @default(true)
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  missedCount   Int       @default(0)
  lastMissedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tasks         Task[]
  taskEvents    TaskEvent[]

  @@map("schedules")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  DONE
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  status      ProjectStatus @default(DRAFT)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]

  @@map("projects")
}

model Task {
  id                           String      @id @default(cuid())
  title                        String
  templateId                   String?
  template                     Template?   @relation(fields: [templateId], references: [id])
  scheduleId                   String?
  schedule                     Schedule?   @relation(fields: [scheduleId], references: [id])
  agentId                      String?
  agent                        Agent?      @relation(fields: [agentId], references: [id])
  dueAt                        DateTime?
  status                       TaskStatus  @default(QUEUE)
  autoDispatch                 Boolean     @default(false)
  autonomyTier                 String?
  dataClass                    String?
  projectId                    String?
  project                      Project?     @relation(fields: [projectId], references: [id])
  instructionsOverride         String?
  assembledInstructionsSnapshot String?
  preInstructionsVersion       String?
  archivedAt                   DateTime?
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt
  taskRuns                     TaskRun[]
  taskEvents                   TaskEvent[]
  dependencies                 TaskDependency[] @relation("TaskDependencies")
  dependedBy                   TaskDependency[] @relation("TaskDependents")

  @@map("tasks")
}

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskRun {
  id              String        @id @default(cuid())
  taskId          String
  task            Task          @relation(fields: [taskId], references: [id])
  attemptNumber   Int           @default(1)
  dispatchedAt    DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  status          TaskRunStatus @default(ACCEPTED)
  wsRequestId     String?
  gatewayRunId    String?
  requestPayload  Json?
  responsePayload Json?
  errorText       String?
  idempotencyKey  String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  taskLogs        TaskLog[]
  taskEvents      TaskEvent[]

  @@map("task_runs")
}

model TaskLog {
  id        String   @id @default(cuid())
  taskRunId String
  taskRun   TaskRun  @relation(fields: [taskRunId], references: [id])
  logText   String
  truncated Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("task_logs")
}

model TaskEvent {
  id         String        @id @default(cuid())
  taskId     String?
  task       Task?         @relation(fields: [taskId], references: [id])
  scheduleId String?
  schedule   Schedule?     @relation(fields: [scheduleId], references: [id])
  taskRunId  String?
  taskRun    TaskRun?      @relation(fields: [taskRunId], references: [id])
  type       TaskEventType
  message    String?
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@map("task_events")
}

model SkillsCache {
  id            String   @id @default(cuid())
  name          String   @unique
  path          String
  mtime         DateTime
  hash          String
  summary       String?
  lastScannedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("skills_cache")
}

model SystemStatus {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_status")
}

enum ApprovalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalDecision {
  PENDING
  APPROVED
  DENIED
  REVISED
}

enum ApprovalDecisionPath {
  MANUAL
  POLICY_AUTO
  SYSTEM
}

enum ApprovalAuditDecision {
  REQUESTED
  APPROVED
  DENIED
  REVISED
  EXPIRED
  CANCELLED
  EXECUTED
}

model ApprovalAuditEvent {
  id           String              @id @default(cuid())
  eventId      String              @unique
  eventVersion Int                 @default(1)

  requestId    String
  taskRunId    String?
  taskId       String?
  projectId    String?
  lane         String?

  role         String
  trigger      String
  severity     ApprovalSeverity
  decision     ApprovalAuditDecision
  decisionPath ApprovalDecisionPath
  deciderType  String
  deciderId    String?

  autonomyTier String?
  dataClass    String?
  summary      String
  evidenceRefs Json?

  createdAt    DateTime            @default(now())
  decidedAt    DateTime?
  latencyMs    Int?
  meta         Json?

  @@index([requestId])
  @@index([trigger])
  @@index([decision])
  @@index([createdAt])
  @@map("approval_audit_events")
}

model ApprovalRequest {
  id           String           @id @default(cuid())
  requestId    String           @unique
  role         String
  trigger      String
  severity     ApprovalSeverity @default(MEDIUM)
  intent       String
  target       String
  risk         String
  rollback     String
  budget       Json?
  context      Json?
  decision     ApprovalDecision @default(PENDING)
  decider      String?
  reason       String?
  outcome      String?
  createdAt    DateTime         @default(now())
  decidedAt    DateTime?
  taskRunId    String?

  @@map("approval_requests")
}
