generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

model Agent {
  id         String    @id @default(cuid())
  name       String
  avatarUrl  String?
  routingKey String    @unique
  enabled    Boolean   @default(true)
  tags       Json      @default("[]")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("agents")
}

model SkillsCache {
  id            String   @id @default(cuid())
  name          String   @unique
  path          String
  mtime         DateTime
  hash          String
  summary       String?
  lastScannedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("skills_cache")
}

model SystemStatus {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_status")
}


enum CpProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CpDocKind {
  PROJECT
  ACTION_PLAN
  NOTES
  ARCHITECTURE
  DECISIONS
  STATUS
  RUNBOOK
}

enum CpDocMode {
  MANAGED
  FROZEN
  EXTERNAL_IMPORT
}

enum CpTrustMode {
  STRICT
  BALANCED
  TRUSTED
}

enum CpPhaseStatus {
  PLANNING
  READY
  ACTIVE
  BLOCKED
  DONE
  ARCHIVED
}

enum CpWorkItemType {
  PLANNING
  EXECUTION
  AUDIT
  REVIEW
  APPROVAL
}

enum CpWorkItemStatus {
  PLANNING
  READY
  BLOCKED
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum CpAutonomyLevel {
  MANUAL
  DRAFT_ONLY
  APPROVAL_GATED
  TRUSTED_AUTO
}

enum CpRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum CpDependencySubjectType {
  PROJECT
  PHASE
  WORK_ITEM
  APPROVAL_GATE
  EXTERNAL_GATE
}

enum CpDependencyEdgeType {
  BLOCKS
  RELATES_TO
  PARENT_OF
  REQUIRES_APPROVAL
  DEPENDS_ON_EXTERNAL
  PHASE_GATE
}

enum CpDependencyScope {
  INTRA_PROJECT
  CROSS_PROJECT
  PHASE_GATE
  OPERATIONAL_GATE
}

enum CpDependencyStrength {
  HARD
  SOFT
}

enum CpApprovalDomain {
  WORKFLOW
  ACTION
}

enum CpApprovalDecisionRule {
  ALLOW
  DENY
  APPROVAL_REQUIRED
  AUTO_RESOLVE_IF_POLICY_MATCH
}

enum CpApprovalRequestStatus {
  PENDING
  APPROVED
  DENIED
  REVISED
  EXPIRED
  AUTO_RESOLVED
}

enum CpApprovalBindingType {
  UNBLOCKS
  ALLOWS_ACTION
  PHASE_EXIT
  OVERRIDE
}

enum CpExecutionRunStatus {
  ACCEPTED
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum CpAuditStatus {
  PENDING
  RUNNING
  COMPLETED
  NEEDS_REVIEW
  ACCEPTED
}

enum CpAuditSourceType {
  LEGACY_MARKDOWN
  MANUAL_REVIEW
  HYBRID
}

enum CpFindingResult {
  VERIFIED_TRUE
  VERIFIED_FALSE
  UNCLEAR
  NEEDS_HUMAN_REVIEW
}

enum CpExportTriggerType {
  MANUAL_UI
  MANUAL_API
  SCHEDULED
  PRE_CHANGE_CHECKPOINT
}

enum CpExportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum CpEventStreamType {
  PROJECT
  PHASE
  WORK_ITEM
  DEPENDENCY
  APPROVAL
  EXECUTION
  AUDIT
  EXPORT
  SYSTEM
}

model CpProject {
  id               String             @id @default(cuid())
  slug             String             @unique
  title            String
  status           CpProjectStatus    @default(DRAFT)
  owner            String?
  defaultTrustMode CpTrustMode        @default(STRICT)
  docMode          CpDocMode          @default(MANAGED)
  summary          String?
  metadata         Json?
  archivedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  settings         CpProjectSetting?
  docs             CpProjectDoc[]
  phases           CpProjectPhase[]
  workItems        CpWorkItem[]
  approvalPolicies CpApprovalPolicy[]
  executionRuns    CpExecutionRun[]
  realityAudits    CpRealityAudit[]
  importBatches    CpImportBatch[]
  exportSnapshots  CpExportSnapshot[]

  @@index([status, archivedAt])
  @@map("cp_projects")
}

model CpProjectSetting {
  projectId                  String            @id
  trustModeOverride          CpTrustMode?
  planningRequiredByDefault  Boolean           @default(false)
  autoExportEnabled          Boolean           @default(false)
  defaultAutonomyLevel       CpAutonomyLevel?
  settingsJson               Json?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  project                    CpProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("cp_project_settings")
}

model CpProjectDoc {
  id            String             @id @default(cuid())
  projectId     String
  kind          CpDocKind
  title         String
  contentMarkdown String
  version       Int                @default(1)
  isActive      Boolean            @default(true)
  lastEditedBy  String?
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  project       CpProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions      CpProjectDocVersion[]

  @@index([projectId, kind])
  @@map("cp_project_docs")
}

model CpProjectDocVersion {
  id             String      @id @default(cuid())
  projectDocId   String
  version        Int
  title          String
  contentMarkdown String
  editedBy       String?
  editReason     String?
  createdAt      DateTime    @default(now())

  projectDoc     CpProjectDoc @relation(fields: [projectDocId], references: [id], onDelete: Cascade)

  @@index([projectDocId, version])
  @@unique([projectDocId, version])
  @@map("cp_project_doc_versions")
}

model CpProjectPhase {
  id                    String          @id @default(cuid())
  projectId             String
  phaseKey              String
  title                 String
  ordinal               Int
  status                CpPhaseStatus   @default(PLANNING)
  planningRequired      Boolean         @default(false)
  entryCriteriaMarkdown String?
  exitCriteriaMarkdown  String?
  summaryMarkdown       String?
  startedAt             DateTime?
  completedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  project               CpProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItems             CpWorkItem[]
  approvalPolicies      CpApprovalPolicy[]
  executionRuns         CpExecutionRun[]

  @@unique([projectId, phaseKey])
  @@unique([projectId, ordinal])
  @@index([projectId, status, archivedAt])
  @@map("cp_project_phases")
}

model CpWorkItem {
  id                         String            @id @default(cuid())
  projectId                  String
  phaseId                    String?
  type                       CpWorkItemType
  title                      String
  descriptionMarkdown        String?
  status                     CpWorkItemStatus  @default(PLANNING)
  autonomyLevel              CpAutonomyLevel   @default(MANUAL)
  riskLevel                  CpRiskLevel       @default(MEDIUM)
  dataClass                  String?
  trustModeOverride          CpTrustMode?
  priority                   Int?
  sourceKind                 String?
  generatedFromAuditFindingId String?
  generatedFromPlanWorkItemId String?
  assignedAgentKey           String?
  autonomousEligible         Boolean           @default(false)
  readyComputedAt            DateTime?
  blockedReasonCache         Json?
  recommendedCapabilities    Json?
  recommendedSkills          Json?
  recommendedTools           Json?
  archivedAt                 DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  project                    CpProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase                      CpProjectPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  generatedFromAuditFinding  CpRealityFinding? @relation(fields: [generatedFromAuditFindingId], references: [id], onDelete: SetNull)
  generatedFromPlanWorkItem  CpWorkItem?       @relation("CpGeneratedWorkItems", fields: [generatedFromPlanWorkItemId], references: [id], onDelete: SetNull)
  generatedWorkItems         CpWorkItem[]      @relation("CpGeneratedWorkItems")
  labels                     CpWorkItemLabel[]
  executionRuns              CpExecutionRun[]

  @@index([projectId, phaseId, status, archivedAt])
  @@index([projectId, type, status])
  @@map("cp_work_items")
}

model CpWorkItemLabel {
  id          String      @id @default(cuid())
  workItemId  String
  label       String
  createdAt   DateTime    @default(now())

  workItem    CpWorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, label])
  @@map("cp_work_item_labels")
}

model CpDependencyEdge {
  id              String                    @id @default(cuid())
  fromSubjectType CpDependencySubjectType
  fromSubjectId   String
  toSubjectType   CpDependencySubjectType
  toSubjectId     String
  edgeType        CpDependencyEdgeType
  scope           CpDependencyScope
  strength        CpDependencyStrength      @default(HARD)
  reason          String?
  createdBy       String?
  archivedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([fromSubjectType, fromSubjectId, archivedAt])
  @@index([toSubjectType, toSubjectId, archivedAt])
  @@map("cp_dependency_edges")
}

model CpApprovalPolicy {
  id             String                 @id @default(cuid())
  domain         CpApprovalDomain
  subjectType    String?
  projectId      String?
  phaseId        String?
  workItemType   CpWorkItemType?
  autonomyLevel  CpAutonomyLevel?
  riskLevel      CpRiskLevel?
  dataClass      String?
  capabilityKey  String?
  decisionRule   CpApprovalDecisionRule
  requiresRole   String?
  priority       Int                    @default(100)
  isActive       Boolean                @default(true)
  ruleJson       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  project        CpProject?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  phase          CpProjectPhase?        @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([domain, isActive, priority])
  @@index([projectId, phaseId, isActive])
  @@map("cp_approval_policies")
}

model CpApprovalRequest {
  id               String                  @id @default(cuid())
  domain           CpApprovalDomain
  subjectType      String
  subjectId        String
  trigger          String
  reason           String
  status           CpApprovalRequestStatus @default(PENDING)
  requiredRole     String?
  requestedByRunId String?
  requestedByActor String?
  expiresAt        DateTime?
  requestedAt      DateTime                @default(now())
  resolvedAt       DateTime?
  metadata         Json?

  requestedByRun   CpExecutionRun?         @relation(fields: [requestedByRunId], references: [id], onDelete: SetNull)
  decisions        CpApprovalDecisionRecord[]
  bindings         CpApprovalBinding[]

  @@index([status, requestedAt])
  @@index([subjectType, subjectId, status])
  @@map("cp_approval_requests")
}

model CpApprovalDecisionRecord {
  id                String             @id @default(cuid())
  approvalRequestId String
  decision          CpApprovalRequestStatus
  decisionMode      String
  decidedBy         String?
  reason            String?
  metadata          Json?
  createdAt         DateTime           @default(now())

  approvalRequest   CpApprovalRequest  @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId, createdAt])
  @@map("cp_approval_decisions")
}

model CpApprovalBinding {
  id                String                 @id @default(cuid())
  approvalRequestId String
  subjectType       String
  subjectId         String
  bindingType       CpApprovalBindingType
  createdAt         DateTime               @default(now())

  approvalRequest   CpApprovalRequest      @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([subjectType, subjectId])
  @@map("cp_approval_bindings")
}

model CpExecutionRun {
  id                           String               @id @default(cuid())
  workItemId                   String
  projectId                    String
  phaseId                      String?
  status                       CpExecutionRunStatus @default(ACCEPTED)
  attemptNumber                Int                  @default(1)
  assembledInstructionsSnapshot String
  gatewayRunId                 String?              @unique
  idempotencyKey               String?              @unique
  errorText                    String?
  responsePayload              Json?
  startedAt                    DateTime?
  finishedAt                   DateTime?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  workItem                     CpWorkItem           @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  project                      CpProject            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase                        CpProjectPhase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  approvalEnvelope             CpRunApprovalEnvelope?
  events                       CpRunEvent[]
  approvalRequests             CpApprovalRequest[]

  @@index([workItemId, createdAt])
  @@index([projectId, status])
  @@map("cp_execution_runs")
}

model CpRunApprovalEnvelope {
  id                  String          @id @default(cuid())
  executionRunId      String          @unique
  trustMode           CpTrustMode
  capabilityPolicyJson Json
  effectivePolicyHash String
  createdAt           DateTime        @default(now())

  executionRun        CpExecutionRun  @relation(fields: [executionRunId], references: [id], onDelete: Cascade)

  @@map("cp_run_approval_envelopes")
}

model CpRunEvent {
  id             String          @id @default(cuid())
  executionRunId String
  eventType      String
  message        String?
  payload        Json?
  occurredAt     DateTime        @default(now())

  executionRun   CpExecutionRun  @relation(fields: [executionRunId], references: [id], onDelete: Cascade)

  @@index([executionRunId, occurredAt])
  @@map("cp_run_events")
}

model CpRealityAudit {
  id             String             @id @default(cuid())
  projectId      String
  status         CpAuditStatus      @default(PENDING)
  sourceType     CpAuditSourceType
  confidenceMode CpTrustMode
  summary        String?
  startedAt      DateTime?
  finishedAt     DateTime?
  acceptedAt     DateTime?
  acceptedBy     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  project        CpProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings       CpRealityFinding[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("cp_reality_audits")
}

model CpRealityFinding {
  id                 String           @id @default(cuid())
  realityAuditId     String
  claimType          String
  claimText          String
  result             CpFindingResult
  evidenceJson       Json?
  proposedNextAction String?
  resolutionNotes    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  realityAudit       CpRealityAudit   @relation(fields: [realityAuditId], references: [id], onDelete: Cascade)
  generatedWorkItems CpWorkItem[]

  @@index([realityAuditId, result])
  @@map("cp_reality_findings")
}

model CpImportBatch {
  id          String      @id @default(cuid())
  projectId   String?
  sourceType  String
  sourceRef   String
  sourceHash  String?
  status      String
  summary     String?
  metadata    Json?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime    @default(now())

  project     CpProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("cp_import_batches")
}

model CpExportSnapshot {
  id          String               @id @default(cuid())
  projectId   String?
  triggerType CpExportTriggerType
  status      CpExportStatus       @default(QUEUED)
  outputPath  String
  manifestHash String?
  requestedBy String?
  errorText   String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime             @default(now())

  project     CpProject?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("cp_export_snapshots")
}

model CpSystemEvent {
  id          String            @id @default(cuid())
  streamType  CpEventStreamType
  subjectType String
  subjectId   String
  eventName   String
  payload     Json?
  actor       String?
  occurredAt  DateTime          @default(now())

  @@index([streamType, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
  @@map("cp_system_events")
}
